# Copia este archivo como backend/.env.local y llena los valores. Nunca subas .env.local.

# Cadena de conexión de Neon (rama production). La pega Dirk a mano.
DATABASE_URL=

# Modo del backend: "example" sirve los JSON de contracts/examples; "live" usa datos reales.
TEPEXA_MODE=example

# Orígenes permitidos para CORS, separados por coma.
TEPEXA_CORS_ORIGINS=http://localhost:5173
