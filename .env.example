# Copia este archivo como backend/.env.local y llena los valores. Nunca subas .env.local.

# Cadena de conexión de Neon (rama production). La pega Dirk a mano. En Render va en el panel.
DATABASE_URL=

# Modo del backend: "example" sirve los JSON de contracts/examples; "live" lee de la base los
# endpoints que ya tienen datos reales (ver /api/v1/health → endpoints).
TEPEXA_MODE=example

# Orígenes permitidos para CORS, separados por coma (URL del frontend en Vercel y localhost).
TEPEXA_CORS_ORIGINS=http://localhost:5173
# Expresión regular para las vistas previas de Vercel, por ejemplo: ^https://tepexa-.*\.vercel\.app$
TEPEXA_CORS_ORIGIN_REGEX=

# Solo para pruebas: PostgreSQL con PostGIS que se puede vaciar (nunca Neon).
TEST_DATABASE_URL=
